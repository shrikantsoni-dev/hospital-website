# Copy to .env.local and fill in real values.

# Zoepact WhatsApp workflow webhook URLs (server-side only).
# Get them from: Zoepact > Workflow > Webhook Callback URL
#
# Two webhooks fire per lead — one to the patient, one to the vendor (our team).
# Short forms (hero / contact / enquiry popup) -> the INQUIRY_* pair.
# Booking forms (with time slot + message)     -> the APPOITMENT_* pair.
INQUIRY_WEBHOOK_URL=
INQUIRY_VENDOR_WEBHOOK_URL=
APPOITMENT_WEBHOOK_URL=
APPOITMENT_VENDOR_WEBHOOK_URL=

# WhatsApp number the vendor (team) notifications are delivered to.
# Sent as vendor_phone / VendorPhone / to. Defaults to 917303771900.
VENDOR_WHATSAPP_NUMBER=
